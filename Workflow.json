    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional meeting intelligence assistant. Analyze the meeting transcript and return ONLY valid JSON using exactly this structure: {\\\"summary\\\":\\\"A concise summary of the meeting\\\",\\\"key_decisions\\\":[\\\"Decision 1\\\",\\\"Decision 2\\\"],\\\"action_items\\\":[{\\\"task\\\":\\\"Task description\\\",\\\"owner\\\":\\\"Person responsible\\\",\\\"deadline\\\":\\\"Deadline or Not specified\\\"}]}. Rules: Extract only decisions explicitly made or clearly agreed upon. Do not invent decisions. Extract actionable tasks with their owner and deadline when available. If no key decisions exist, return an empty array. If no action items exist, return an empty array. Return ONLY valid JSON. No markdown. No explanation outside the JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $json.text }}\"\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
      },
      "id": "04cd5bde-575b-43e4-8395-0ee606a21f6d",
      "name": "Groq LLM - Summarize + Extract Action Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    summary: raw,\n    key_decisions: [],\n    action_items: []\n  };\n}\n\nconst actionItems = parsed.action_items || [];\nconst keyDecisions = parsed.key_decisions || [];\n\nconst actionItemsText = actionItems\n  .map(a => `- ${a.task} (Owner: ${a.owner}, Deadline: ${a.deadline})`)\n  .join('\\n');\n\nconst keyDecisionsText = keyDecisions\n  .map(d => `- ${d}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    summary: parsed.summary || 'No summary generated.',\n    action_items_text: actionItemsText || 'No action items detected.',\n    key_decisions_text: keyDecisionsText || 'No key decisions detected.',\n    action_items_raw: actionItems,\n    key_decisions_raw: keyDecisions,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "c4753c4c-df6d-414b-9a65-26f33502e3cc",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        96
      ]
    },
    {
      "parameters": {
        "sendTo": "your-email@example.com",
        "subject": "=Meeting Intelligence Report — {{ $now.format('dd LLL yyyy, HH:mm') }}",
        "emailType": "text",
        "message": "=Hello,\n\nHere is your AI-generated meeting report.\n\n📌 MEETING SUMMARY\n\n{{ $json.summary }}\n\n🎯 KEY DECISIONS\n\n{{ $json.key_decisions_text }}\n\n✅ ACTION ITEMS\n\n{{ $json.action_items_text }}\n\nThis report was automatically generated by the AI Meeting Intelligence & Automation workflow.\n\nBest regards,\nAI Meeting Assistant",
        "options": {
          "appendAttribution": false
        }
      },
